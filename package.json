{
  "name": "breakpoint-funded",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --env-file-if-exists=.env backend/server.mjs",
    "test:api": "node --env-file-if-exists=.env --test --test-isolation=none backend/*.test.mjs",
    "db:up": "docker compose up -d --wait db",
    "db:stop": "docker compose stop db",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\""
  },
  "dependencies": {
    "@web3icons/react": "^4.1.24",
    "lucide-react": "^1.65.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  }
}

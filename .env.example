# Local development only. Copy to .env and replace both password placeholders.
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgresql://breakpoint_dev:replace_with_a_long_random_password@127.0.0.1:5433/breakpoint
API_HOST=127.0.0.1
API_PORT=3101
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NODE_ENV=development
